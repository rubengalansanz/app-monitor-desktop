{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "sql:default",
    "sql:allow-execute",
    "allow-start-monitor",
    "allow-stop-monitor",
    "allow-get-active-session",
    "allow-get-sessions",
    "allow-agent-status"
  ]
}